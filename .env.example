# Copy to .env and fill in.

# DeepSeek API key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Local SearXNG started with `docker compose up -d`
SEARX_URL=http://localhost:8080
# Generate with: openssl rand -hex 32
SEARXNG_SECRET=

# Any GPT Researcher setting from config.json can be overridden here, e.g.:
# TOTAL_WORDS=2500

# Telegram bot (uv run bot.py): token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot; the bot tells strangers their ID
TELEGRAM_ALLOWED_USERS=

# Web search backend: searx (local SearXNG, default) or tavily (e.g. on Railway)
# WEB_RETRIEVER=tavily
# TAVILY_API_KEY=

# Web app (uv run app.py): password; required when it listens publicly (Railway)
APP_PASSWORD=

# Optional free Jina Reader key (https://jina.ai/reader): pages the scraper can't read are re-read
# through Jina at 500 requests a minute instead of 20 without a key
# JINA_API_KEY=

# Copy to .env and fill in.

# DeepSeek API key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Local SearXNG started with `docker compose up -d`
SEARX_URL=http://localhost:8080
# Generate with: openssl rand -hex 32
SEARXNG_SECRET=

# Any GPT Researcher setting from config.json can be overridden here, e.g.:
# TOTAL_WORDS=2500

# Telegram bot (runs inside uv run app.py, or alone: uv run python -m my_browser.bot): token from @BotFather.
# Never the production token in local runs: two pollers of one token break the bot on Railway.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot; the bot tells strangers their ID
TELEGRAM_ALLOWED_USERS=

# Web search backend: searx (local SearXNG, default) or tavily (e.g. on Railway)
# WEB_RETRIEVER=tavily
# TAVILY_API_KEY=

# Web app (uv run app.py): password; required when it listens publicly (Railway)
APP_PASSWORD=

# Optional free Jina Reader key (https://jina.ai/reader): pages the scraper can't read are re-read
# through Jina at 500 requests a minute instead of 20 without a key
# JINA_API_KEY=

# Parts run in one process by default (uv run app.py). When they run separately
# (python -m my_browser.core / .worker / .search / .bot), tell them where the others are
# and share one token:
# CORE_URL=http://127.0.0.1:8501
# WORKER_URL=http://127.0.0.1:8502
# SEARCH_URL=http://127.0.0.1:8503
# SERVICE_TOKEN=
